def midi(n):
    return 0 if n <= 0 else 440.0 * 2 ** ((n - 69) / 12)


INTRO_MEL = [(72, 2), (76, 2), (79, 2), (76, 1), (79, 1), (84, 4), (83, 2), (79, 2),
             (76, 2), (79, 2), (77, 2), (74, 2), (71, 2), (74, 1), (77, 1), (79, 4),
             (76, 2), (72, 2), (74, 2), (71, 2), (72, 6), (0, 2)]
INTRO_BASS = [(48, 4), (55, 4), (48, 4), (55, 4), (53, 4), (50, 4), (55, 4), (55, 4),
              (48, 4), (53, 4), (55, 4), (48, 4)]
CLEAR_MEL = [(79, 1), (84, 1), (88, 1), (91, 3), (88, 1), (91, 4)]
LIFE_MEL = [(84, 1), (88, 1), (91, 1), (96, 3)]


class Audio:
    def __init__(self):
        self.ok, self.snd, self.loop_name, self.flip = False, {}, None, False
        try:
            if not pygame.mixer.get_init():
                pygame.mixer.init(22050, -16, 1, 512)
            self.rate, _, self.nch = pygame.mixer.get_init()
            pygame.mixer.set_num_channels(10)
            pygame.mixer.set_reserved(2)
            self.loop_ch = pygame.mixer.Channel(0)
            self.chomp_ch = pygame.mixer.Channel(1)
            self.build()
            self.load_arcade_samples()
            self.ok = True
        except Exception as e:
            print("audio disabled:", e)

    def tone(self, freq, dur, wave='pulse', duty=0.5, vol=0.25, slide=0.0):
        n = max(1, int(self.rate * dur))
        if freq <= 0:
            return [0.0] * n
        out, ph, nv = [0.0] * n, 0.0, 1.0
        rate = self.rate
        for i in range(n):
            f = freq + slide * i / n
            ph += f / rate
            if ph >= 1.0:
                ph -= int(ph)
                nv = 1.0 if random.getrandbits(1) else -1.0
            if wave == 'pulse':
                s = 1.0 if ph < duty else -1.0
            elif wave == 'tri':
                s = round((4 * abs(ph - 0.5) - 1) * 7.5) / 7.5   # 4-bit stepped tri
            else:
                s = nv
            env = min(1.0, (n - i) / 150.0)
            out[i] = s * vol * env
        return out

    def seq(self, notes, wave='pulse', duty=0.5, vol=0.2, step=0.1):
        out = []
        for n, steps in notes:
            d = step * steps
            out += self.tone(midi(n), d * 0.9, wave, duty, vol) + [0.0] * int(self.rate * d * 0.1)
        return out

    @staticmethod
    def mix(*voices):
        n = max(len(v) for v in voices)
        out = [0.0] * n
        for v in voices:
            for i, s in enumerate(v):
                out[i] += s
        return out

    def make(self, samples):
        a = array.array('h', (int(max(-1.0, min(1.0, s)) * 30000) for s in samples))
        if self.nch == 2:
            b = array.array('h', [0]) * (2 * len(a))
            b[0::2] = a
            b[1::2] = a
            a = b
        return pygame.mixer.Sound(buffer=a.tobytes())

    def build(self):
        t, S = self.tone, {}
        S['chomp_a'] = t(560, .07, 'pulse', .25, .2, slide=-300)
        S['chomp_b'] = t(260, .07, 'pulse', .25, .2, slide=300)
        S['siren'] = t(330, .2, 'tri', vol=.3, slide=220) + t(550, .2, 'tri', vol=.3, slide=-220)
        S['fright'] = sum((t(150, .055, 'pulse', .5, .13, slide=260) for _ in range(4)), [])
        S['return'] = sum((t(900, .04, 'pulse', .125, .1, slide=-500) for _ in range(3)), [])
        S['eat'] = t(180, .32, 'pulse', .5, .25, slide=1500)
        S['bonus'] = t(880, .08, 'pulse', .5, .22) + t(1320, .14, 'pulse', .5, .22)
        S['nip'] = t(400, .12, 'pulse', .125, .22, slide=600)
        death = []
        for k in range(9):
            death += t(780 - 60 * k, .1, 'pulse', .5, .24, slide=-280)
        S['death'] = death + t(900, .1, 'noise', vol=.25) + t(500, .2, 'noise', vol=.2)
        S['intro'] = self.mix(self.seq(INTRO_MEL, 'pulse', .5, .18),
                              self.seq(INTRO_BASS, 'tri', vol=.35))
        S['clear'] = self.seq(CLEAR_MEL, 'pulse', .25, .2, step=.08)
        S['life'] = self.seq(LIFE_MEL, 'pulse', .25, .2, step=.07)
        S['start'] = t(1046, .05, 'pulse', .5, .2) + t(1568, .08, 'pulse', .5, .2)
        for k, v in S.items():
            self.snd[k] = self.make(v)

    def load_arcade_samples(self):
        """Prefer user-supplied original arcade audio, especially the opening jingle."""
        root = Path(__file__).resolve().parent
        folders = (root / 'pacman_audio', root / 'audio', root / 'sounds', root)
        aliases = {
            'intro': ('intro', 'pacman_beginning', 'pacman_intro', 'game_start', 'beginning'),
            'chomp_a': ('chomp_a', 'waka1', 'munch1'),
            'chomp_b': ('chomp_b', 'waka2', 'munch2'),
            'death': ('death', 'pacman_death'),
        }
        loaded = []
        for event in tuple(self.snd):
            names = aliases.get(event, (event,))
            for folder in folders:
                match = next((folder / (name + ext) for name in names
                              for ext in ('.wav', '.ogg', '.mp3')
                              if (folder / (name + ext)).is_file()), None)
                if match is None:
                    continue
                try:
                    self.snd[event] = pygame.mixer.Sound(str(match))
                    loaded.append(event)
                    break
                except (pygame.error, OSError) as exc:
                    print(f'Could not load {match}: {exc}')
        if 'intro' not in loaded:
            print('NOTE: Original Pac-Man opening jingle is not bundled. '
                  'Put your recording at pacman_audio/intro.wav to hear the authentic intro.')
        if loaded:
            print('External audio loaded:', ', '.join(loaded))

    def length(self, name):
        return self.snd[name].get_length() if self.ok else 2.0

    def play(self, name):
        if self.ok:
            self.snd[name].play()

    def chomp(self):
        if self.ok:
            self.flip = not self.flip
            self.chomp_ch.play(self.snd['chomp_a' if self.flip else 'chomp_b'])

    def loop(self, name):
        if not self.ok or name == self.loop_name:
            return
        self.loop_name = name
        if name is None:
            self.loop_ch.stop()
        else:
            self.loop_ch.play(self.snd[name], loops=-1)

    def stop_all(self):
        if self.ok:
            pygame.mixer.stop()
        self.loop_name = None


# ---- Maze ------------------------------------------------------------------
class Maze:
    def __init__(self):
        self.grid = [list(r) for r in MAZE]
        self.start = next((c, r) for r in range(H) for c in range(W) if MAZE[r][c] == 'P')
        self.docks = [(c, r) for r in range(H) for c in range(W) if MAZE[r][c] == 'G']
        self.reset()

    def reset(self):
        self.pellets = {(c, r) for r in range(H) for c in range(W) if MAZE[r][c] == '.'}
        self.nips = {(c, r) for r in range(H) for c in range(W) if MAZE[r][c] == 'o'}
        self.total = len(self.pellets) + len(self.nips)

    def at(self, c, r):
        if r < 0 or r >= H:
            return '#'
        return self.grid[r][c % W]

    def open_player(self, c, r):
        return self.at(c, r) not in '#-G'

    def open_robot(self, c, r, door_ok):
        ch = self.at(c, r)
        return ch != '#' and (ch != '-' or door_ok)

    def wall(self, c, r):
        return 0 <= r < H and 0 <= c < W and MAZE[r][c] == '#'

    def render(self, edge):
        s = pygame.Surface((W * TILE, H * TILE))
        s.fill(C['bg'])
        for inset, col in ((5, edge), (8, C['wall_fill'])):
            for r in range(H):
                for c in range(W):
                    if not self.wall(c, r):
                        continue
                    x0 = c * TILE + (inset if not self.wall(c - 1, r) else 0)
                    x1 = (c + 1) * TILE - (inset if not self.wall(c + 1, r) else 0)
                    y0 = r * TILE + (inset if not self.wall(c, r - 1) else 0)
                    y1 = (r + 1) * TILE - (inset if not self.wall(c, r + 1) else 0)
                    if x1 > x0 and y1 > y0:
                        pygame.draw.rect(s, col, (x0, y0, x1 - x0, y1 - y0))
        for r in range(H):
            for c in range(W):
                if MAZE[r][c] == '-':
                    pygame.draw.rect(s, C['door'], (c * TILE, r * TILE + TILE // 2 - 2, TILE, 4))
        return s


# ---- Movers ----------------------------------------------------------------
class Mover:
    def place(self, tx, ty, d=STOP):
        self.tx, self.ty, self.dir, self.prog = tx, ty, d, 0.0

    @property
    def pos(self):
        return self.tx + self.dir[0] * self.prog, self.ty + self.dir[1] * self.prog

    def reverse(self):
        if self.dir != STOP:
            self.tx = (self.tx + self.dir[0]) % W
            self.ty += self.dir[1]
            self.dir = (-self.dir[0], -self.dir[1])
            self.prog = 1.0 - self.prog

    def step_tile(self):
        self.tx = (self.tx + self.dir[0]) % W
        self.ty += self.dir[1]


class Cat(Mover):
    def __init__(self, maze):
        self.maze = maze
        self.reset()

    def reset(self):
        self.place(*self.maze.start)
        self.want, self.face, self.anim = LEFT, LEFT, 0.0

    def update(self, dt, speed, game):
        m = self.maze
        if self.dir == STOP:
            if self.want and m.open_player(self.tx + self.want[0], self.ty + self.want[1]):
                self.dir, self.prog = self.want, 0.0
            else:
                return
        if self.want == (-self.dir[0], -self.dir[1]):
            self.reverse()
        self.face = self.dir
        self.anim += dt
        self.prog += speed * dt
        while self.prog >= 1.0:
            self.prog -= 1.0
            self.step_tile()
            game.cat_on_tile(self.tx, self.ty)
            if self.want and m.open_player(self.tx + self.want[0], self.ty + self.want[1]):
                self.dir = self.want
            elif not m.open_player(self.tx + self.dir[0], self.ty + self.dir[1]):
                self.dir, self.prog = STOP, 0.0
                break
            self.face = self.dir


class Robot(Mover):
    def __init__(self, name, color, dock, corner, kind, delay):
        self.name, self.color, self.dock, self.corner = name, color, dock, corner
        self.kind, self.delay = kind, delay
        self.reset()

    def reset(self):
        self.place(*self.dock)
        self.state, self.timer, self.scared, self.anim, self.eaten_t = 'house', self.delay, False, 0.0, 0.0

    def door_ok(self):
        return self.state in ('leave', 'eaten')

    def target(self, g):
        p = g.cat
        if self.state == 'leave':
            return EXIT_TILE
        if self.state == 'eaten':
            return EXIT_TILE
        if g.mode == 'scatter':
            return self.corner
        if self.kind == 'ambush':
            return p.tx + p.face[0] * 3, p.ty + p.face[1] * 3
        if self.kind == 'shy' and math.hypot(p.tx - self.tx, p.ty - self.ty) < 6:
            return self.corner
        return p.tx, p.ty

    def choose(self, g):
        rev = (-self.dir[0], -self.dir[1])
        opts = [d for d in ORDER
                if (self.dir == STOP or d != rev)
                and g.maze.open_robot(self.tx + d[0], self.ty + d[1], self.door_ok())]
        if not opts:
            return rev if g.maze.open_robot(self.tx + rev[0], self.ty + rev[1], self.door_ok()) else STOP
        if self.scared and self.state == 'active':
            return random.choice(opts)
        tx, ty = self.target(g)
        return min(opts, key=lambda d: (self.tx + d[0] - tx) ** 2 + (self.ty + d[1] - ty) ** 2)

    def speed(self, g):
        base = min(8.2, 6.6 + 0.25 * (g.level - 1))
        if self.state == 'eaten':
            return 14.0
        if self.state == 'leave':
            return 4.0
        if self.ty == 10 and (self.tx < 5 or self.tx > 15):
            return 3.6
        return 4.0 if self.scared else base

    def update(self, dt, g):
        self.anim += dt
        if self.state == 'house':
            self.timer -= dt
            if self.timer <= 0:
                self.state, self.dir, self.prog = 'leave', STOP, 0.0
            return
        if self.state == 'eaten':
            self.eaten_t += dt
            if self.eaten_t > 8:           # safety net: teleport home
                self.place(*HOUSE_TILE)
                self.state, self.scared = 'leave', False
        if self.dir == STOP:
            self.dir = self.choose(g)
            if self.dir == STOP:
                return
        self.prog += self.speed(g) * dt
        while self.prog >= 1.0:
            self.prog -= 1.0
            self.step_tile()
            here = (self.tx, self.ty)
            if self.state == 'leave' and here == EXIT_TILE:
                self.state = 'active'
            elif self.state == 'eaten' and here in (EXIT_TILE, (10, 9)):
                self.dir = DOWN
                continue
            elif self.state == 'eaten' and here == HOUSE_TILE:
                self.state, self.scared, self.dir = 'leave', False, STOP
            self.dir = self.choose(g)
            if self.dir == STOP:
                self.prog = 0.0
                break


# ---- Sprite factory --------------------------------------------------------
class Sprites:
    """Procedural arcade-style graphics; no copyrighted ROM assets required."""
    def __init__(self):
        self.cache = {}
        self.fish = pygame.Surface((22, 22), pygame.SRCALPHA)
        pygame.draw.circle(self.fish, (255, 0, 0), (8, 13), 6)
        pygame.draw.circle(self.fish, (255, 0, 0), (15, 13), 6)
        pygame.draw.line(self.fish, (0, 180, 0), (11, 8), (15, 3), 2)

    def cat(self, face, mouth):
        """Arcade-inspired 13x13 pixel Pac-Man, scaled with hard pixel edges.

        Mouth points in the actual movement direction (pygame Y grows down).
        Three frames: closed, narrow, wide.
        """
        key = ('pac', face, mouth)
        if key not in self.cache:
            tiny = pygame.Surface((13, 13), pygame.SRCALPHA)
            dx, dy = face if face != STOP else RIGHT
            half_angle = (0.0, 19.0, 43.0)[max(0, min(2, mouth))]
            for y in range(13):
                for x in range(13):
                    vx, vy = x - 6, y - 6
                    # Pixel-art disk, intentionally symmetric around tile center.
                    if vx * vx + vy * vy > 36:
                        continue
                    if half_angle and (vx or vy):
                        dot = vx * dx + vy * dy
                        cross = abs(vx * dy - vy * dx)
                        if dot > 0 and cross < dot * math.tan(math.radians(half_angle)):
                            continue
                    tiny.set_at((x, y), C['yellow'])
            self.cache[key] = pygame.transform.scale(tiny, (26, 26))
        return self.cache[key]

    def robot(self, color, face, tread, mode):
        key = ('ghost', color, face, tread, mode)
        if key not in self.cache:
            surf = pygame.Surface((26, 26), pygame.SRCALPHA)
            if mode != 'eyes':
                body = color if mode == 'normal' else ((255, 255, 255) if mode == 'flash' else (32, 32, 255))
                pygame.draw.circle(surf, body, (13, 12), 12)
                pygame.draw.rect(surf, body, (1, 12, 24, 9))
                points = [(1, 21)]
                for i in range(4):
                    x = 1 + i * 6
                    if (i + tread) % 2:
                        points.extend([(x + 3, 25), (x + 6, 21)])
                    else:
                        points.extend([(x + 3, 21), (x + 6, 25)])
                points.extend([(25, 12), (1, 12)])
                pygame.draw.polygon(surf, body, points)
            if mode in ('normal', 'eyes'):
                dx, dy = face
                for x in (8, 18):
                    pygame.draw.ellipse(surf, (255, 255, 255), (x - 5, 8, 9, 11))
                    pygame.draw.circle(surf, (25, 25, 190), (x - 1 + dx * 2, 13 + dy * 2), 3)
            else:
                eye = (255, 0, 0) if mode == 'flash' else (255, 255, 255)
                for x in (9, 17):
                    pygame.draw.circle(surf, eye, (x, 13), 2)
                pygame.draw.lines(surf, eye, False, [(6, 20), (9, 18), (12, 20), (15, 18), (19, 20)], 2)
            self.cache[key] = surf
        return self.cache[key]


# ---- Game ------------------------------------------------------------------
MODES = [('scatter', 7), ('chase', 20), ('scatter', 7), ('chase', 20), ('scatter', 5), ('chase', 1e9)]


class Game:
    def __init__(self, screen, audio):
        self.screen, self.audio = screen, audio
        self.maze = Maze()
        self.walls = self.maze.render(C['wall_edge'])
        self.walls_flash = self.maze.render(C['white'])
        self.spr = Sprites()
        self.cat = Cat(self.maze)
        self.robots = [
            Robot('BLINKY', C['red'], (10, 10), (19, -2), 'chase', 0.0),
            Robot('INKY', C['cyan'], (9, 10), (1, -2), 'ambush', 3.0),
            Robot('CLYDE', C['orange'], (11, 10), (1, 23), 'shy', 7.0),
        ]
        self.font = pygame.font.Font(None, 30)
        self.big = pygame.font.Font(None, 60)
        self.small = pygame.font.Font(None, 22)
        self.hi, self.score, self.lives, self.level = 0, 0, 3, 1
        self.state, self.t, self.paused = 'title', 0.0, False
        self.popups = []

    # -- flow --
    def new_game(self):
        self.score, self.lives, self.level, self.extra = 0, 3, 1, False
        self.maze.reset()
        self.start_round(intro=True)

    def start_round(self, intro=False):
        self.cat.reset()
        for r in self.robots:
            r.reset()
        self.mode_i, self.mode_t = 0, MODES[0][1]
        self.fright_t, self.combo, self.freeze = 0.0, 0, 0.0
        self.bonus, self.bonus_t, self.popups = False, 0.0, []
        self.audio.stop_all()
        if intro:
            self.audio.play('intro')
            self.t = max(2.0, self.audio.length('intro'))
        else:
            self.t = 2.0
        self.state = 'ready'

    @property
    def mode(self):
        return MODES[self.mode_i][0]

    def add_score(self, n):
        self.score += n
        self.hi = max(self.hi, self.score)
        if not self.extra and self.score >= 10000:
            self.extra = True
            self.lives += 1
            self.audio.play('life')

    def fright_len(self):
        return max(1.5, 6.5 - 0.5 * (self.level - 1))

    def cat_on_tile(self, c, r):
        key = (c, r)
        if key in self.maze.pellets:
            self.maze.pellets.discard(key)
            self.add_score(10)
            self.audio.chomp()
        elif key in self.maze.nips:
            self.maze.nips.discard(key)
            self.add_score(50)
            self.audio.play('nip')
            self.fright_t, self.combo = self.fright_len(), 0
            for rb in self.robots:
                if rb.state in ('active', 'leave', 'house'):
                    rb.scared = True
                    if rb.state == 'active':
                        rb.reverse()
        else:
            return
        left = len(self.maze.pellets) + len(self.maze.nips)
        eaten = self.maze.total - left
        if eaten in (70, 170) and not self.bonus:
            self.bonus, self.bonus_t = True, 9.5
        self.check_clear()

    def check_clear(self):
        if not self.maze.pellets and not self.maze.nips and self.state == 'play':
            self.audio.stop_all()
            self.audio.play('clear')
            self.state, self.t = 'clear', 2.4

    def key(self, k):
        if k == pygame.K_ESCAPE:
            return False
        dirs = {pygame.K_UP: UP, pygame.K_w: UP, pygame.K_DOWN: DOWN, pygame.K_s: DOWN,
                pygame.K_LEFT: LEFT, pygame.K_a: LEFT, pygame.K_RIGHT: RIGHT, pygame.K_d: RIGHT}
        if k in dirs:
            self.cat.want = dirs[k]
        if self.state == 'title':
            if k in (pygame.K_RETURN, pygame.K_SPACE):
                self.audio.play('start')
                self.new_game()
            elif k == pygame.K_c:
                self.state = 'credits'
        elif self.state == 'credits':
            self.state = 'title'
        elif k == pygame.K_p and self.state == 'play':
            self.paused = not self.paused
            self.audio.loop(None)
        return True

    # -- update --
    def update(self, dt):
        if self.paused:
            return
        self.t -= dt
        self.popups = [(x, y, txt, tt - dt) for x, y, txt, tt in self.popups if tt - dt > 0]
        st = self.state
        if st in ('title', 'credits'):
            self.anim = getattr(self, 'anim', 0.0) + dt
        elif st == 'ready':
            if self.t <= 0:
                self.state = 'play'
        elif st == 'play':
            self.update_play(dt)
        elif st == 'dying':
            if self.t <= 1.7 and not getattr(self, 'death_snd', False):
                self.death_snd = True
                self.audio.play('death')
            if self.t <= 0:
                self.lives -= 1
                if self.lives <= 0:
                    self.state, self.t = 'gameover', 3.0
                else:
                    self.start_round()
        elif st == 'clear':
            if self.t <= 0:
                self.level += 1
                self.maze.reset()
                self.start_round()
        elif st == 'gameover':
            if self.t <= 0:
                self.state = 'title'

    def update_play(self, dt):
        if self.freeze > 0:
            self.freeze -= dt
            return
        if self.fright_t > 0:
            self.fright_t -= dt
            if self.fright_t <= 0:
                for r in self.robots:
                    r.scared = False
        else:
            self.mode_t -= dt
            if self.mode_t <= 0 and self.mode_i < len(MODES) - 1:
                self.mode_i += 1
                self.mode_t = MODES[self.mode_i][1]
                for r in self.robots:
                    if r.state == 'active':
                        r.reverse()
        cat_speed = min(8.6, 7.2 + 0.2 * (self.level - 1))
        if self.fright_t > 0:
            cat_speed += 0.6
        self.cat.update(dt, cat_speed, self)
        if self.state != 'play':
            return
        for r in self.robots:
            r.update(dt, self)
        if self.bonus:
            self.bonus_t -= dt
            if self.bonus_t <= 0:
                self.bonus = False
            elif (self.cat.tx, self.cat.ty) == BONUS_TILE:
                self.bonus = False
                pts = 300 + 200 * min(self.level, 10)
                self.add_score(pts)
                self.audio.play('bonus')
                self.popups.append((BONUS_TILE[0], BONUS_TILE[1], str(pts), 1.5))
        # collisions
        cx, cy = self.cat.pos
        for r in self.robots:
            if r.state not in ('active', 'leave'):
                continue
            rx, ry = r.pos
            if abs(rx - cx) + abs(ry - cy) < 0.75:
                if r.scared:
                    pts = 200 * 2 ** self.combo
                    self.combo = min(self.combo + 1, 3)
                    self.add_score(pts)
                    r.state, r.scared, r.eaten_t = 'eaten', False, 0.0
                    self.popups.append((rx, ry, str(pts), 0.8))
                    self.freeze = 0.6
                    self.audio.play('eat')
                else:
                    self.audio.stop_all()
                    self.state, self.t, self.death_snd = 'dying', 2.4, False
                    return
        # background loop
        if any(r.state == 'eaten' for r in self.robots):
            self.audio.loop('return')
        elif self.fright_t > 0:
            self.audio.loop('fright')
        else:
            self.audio.loop('siren')

    # -- draw --
    def px(self, x, y):
        return int(x * TILE + TILE / 2), int(HUD_TOP + y * TILE + TILE / 2)

    def blit_c(self, surf, x, y):
        for ox in (0, -W, W):
            xx = x + ox
            if -1 <= xx <= W:
                self.screen.blit(surf, surf.get_rect(center=self.px(xx, y)))

    def text(self, s, x, y, col, font=None, center=True):
        img = (font or self.font).render(s, False, col)
        r = img.get_rect(center=(x, y)) if center else img.get_rect(topleft=(x, y))
        self.screen.blit(img, r)

    def draw(self):
        self.screen.fill(C['bg'])
        if self.state == 'title':
            self.draw_title()
        elif self.state == 'credits':
            self.draw_credits()
        else:
            self.draw_game()
        if self.paused:
            self.text("PAUSED", SCREEN_W // 2, HUD_TOP + 12.5 * TILE, C['yellow'])

    def draw_hud(self):
        self.text("1UP", 70, 14, C['white'])
        self.text(f"{self.score:06d}", 70, 34, C['white'])
        self.text("HI SCORE", SCREEN_W // 2, 14, C['white'])
        self.text(f"{self.hi:06d}", SCREEN_W // 2, 34, C['white'])
        self.text(f"LV {self.level:02d}", SCREEN_W - 60, 24, C['yellow'])
        y = HUD_TOP + H * TILE + HUD_BOT // 2
        icon = self.spr.cat(RIGHT, 0)
        for i in range(max(0, self.lives - 1)):
            self.screen.blit(icon, icon.get_rect(center=(30 + i * 32, y)))
        for i in range(min(self.level, 7)):
            self.screen.blit(self.spr.fish, self.spr.fish.get_rect(center=(SCREEN_W - 30 - i * 32, y)))

    def draw_game(self):
        self.draw_hud()
        flash = self.state == 'clear' and int(self.t * 5) % 2 == 0 and self.t < 2.0
        self.screen.blit(self.walls_flash if flash else self.walls, (0, HUD_TOP))
        if self.state != 'clear':
            for (c, r) in self.maze.pellets:
                x, y = self.px(c, r)
                pygame.draw.rect(self.screen, C['pellet'], (x - 2, y - 2, 4, 4))
            if int(pygame.time.get_ticks() / 200) % 2 or self.state != 'play':
                for (c, r) in self.maze.nips:
                    x, y = self.px(c, r)
                    pygame.draw.circle(self.screen, C['pellet'], (x, y), 7)
        if self.bonus and self.state == 'play':
            self.blit_c(self.spr.fish, *BONUS_TILE)
        # robots
        show_bots = self.state in ('ready', 'play', 'gameover') or (self.state == 'dying' and self.t > 1.8)
        if show_bots:
            for r in self.robots:
                x, y = r.pos
                if r.state == 'house':
                    y += math.sin(r.anim * 8) * 0.25
                    face = UP if int(r.anim * 2) % 2 else DOWN
                else:
                    face = r.dir if r.dir != STOP else UP
                tread = int(r.anim * 10) % 2
                if r.state == 'eaten':
                    mode = 'eyes'
                elif r.scared:
                    mode = 'flash' if self.fright_t < 2.0 and int(self.fright_t * 6) % 2 == 0 else 'scared'
                else:
                    mode = 'normal'
                self.blit_c(self.spr.robot(r.color, face, tread, mode), x, y)
        # cat
        cx, cy = self.cat.pos
        if self.state == 'dying':
            if self.t <= 1.8:
                k = max(0.0, self.t / 1.8)
                img = pygame.transform.rotozoom(self.spr.cat(DOWN, 2), (1 - k) * 720, max(0.05, k))
                self.blit_c(img, cx, cy)
            else:
                self.blit_c(self.spr.cat(self.cat.face, 0), cx, cy)
        elif self.state != 'gameover':
            mouth = [0, 1, 2, 1][int(self.cat.anim * 14) % 4] if self.cat.dir != STOP else 1
            self.blit_c(self.spr.cat(self.cat.face, mouth), cx, cy)
        for x, y, txt, _ in self.popups:
            self.text(txt, *self.px(x, y), C['cyan'], self.small)
        mid = SCREEN_W // 2, HUD_TOP + int(12.5 * TILE)
        if self.state == 'ready':
            self.text("READY!", *mid, C['yellow'])
        elif self.state == 'gameover':
            self.text("GAME  OVER", *mid, C['red'])

    def draw_title(self):
        a = getattr(self, 'anim', 0.0)
        self.text("A.C HOLDINGS  /  TEAM FLAMES", SCREEN_W // 2, 40, C['gray'], self.small)
        self.text("CAT'S", SCREEN_W // 2, 100, C['yellow'], self.big)
        self.text("PACMAN", SCREEN_W // 2, 150, C['yellow'], self.big)
        self.text("VER 0.1", SCREEN_W // 2, 190, C['white'], self.small)
        self.text("- CHARACTER  /  NICKNAME -", SCREEN_W // 2, 245, C['white'])
        roles = ["THE HUNTER", "THE TRICKSTER", "THE SKITTISH"]
        for i, r in enumerate(self.robots):
            y = 290 + i * 46
            img = self.spr.robot(r.color, RIGHT, int(a * 6) % 2, 'normal')
            self.screen.blit(img, img.get_rect(center=(110, y)))
            self.text(f"{roles[i]:<14}", 160, y - 10, r.color, center=False)
            self.text(f'"{r.name}"', 360, y - 10, r.color, center=False)
        pygame.draw.rect(self.screen, C['pellet'], (180, 440, 5, 5))
        self.text("10 PTS", 200, 433, C['white'], center=False)
        pygame.draw.circle(self.screen, C['pellet'], (297, 440), 7)
        self.text("50 PTS", 315, 433, C['white'], center=False)
        # marching demo
        x = (a * 120) % (SCREEN_W + 260) - 130
        mouth = [0, 1, 2, 1][int(a * 14) % 4]
        cat = self.spr.cat(RIGHT, mouth)
        self.screen.blit(cat, cat.get_rect(center=(int(x), 500)))
        for i, r in enumerate(self.robots):
            img = self.spr.robot(r.color, RIGHT, int(a * 8) % 2, 'normal')
            self.screen.blit(img, img.get_rect(center=(int(x) - 60 - i * 34, 500)))
        if int(a * 2) % 2 == 0:
            self.text("PUSH  ENTER", SCREEN_W // 2, 550, C['yellow'])
        self.text(f"HI SCORE {self.hi:06d}", SCREEN_W // 2, 580, C['white'], self.small)
        self.text("C - CREDITS     ESC - QUIT", SCREEN_W // 2, 600, C['gray'], self.small)

    def draw_credits(self):
        lines = [
            ("STAFF", C['yellow'], self.big),
            ("", None, None),
            ("GAME DESIGN & PROGRAM", C['orange'], self.font),
            ("CLAUDE", C['white'], self.font),
            ("AC KONDO", C['white'], self.font),
            ("", None, None),
            ("FAMICOM-STYLE SOUND", C['orange'], self.font),
            ("PULSE  /  TRIANGLE  /  NOISE", C['white'], self.small),
            ("", None, None),
            ("ARCADE-STYLE GRAPHICS", C['orange'], self.font),
            ("PROCEDURAL PACMAN / GHOSTS", C['white'], self.small),
            ("", None, None),
            ("PRESENTED BY", C['orange'], self.font),
            ("A.C HOLDINGS  /  TEAM FLAMES", C['white'], self.font),
            ("", None, None),
            ("PUSH ANY KEY", C['gray'], self.small),
        ]
        y = 90
        for s, col, f in lines:
            if s:
                self.text(s, SCREEN_W // 2, y, col, f)
            y += 34


# ---- Main ------------------------------------------------------------------
def main():
    selftest = '--selftest' in sys.argv
    try:
        pygame.mixer.pre_init(22050, -16, 1, 512)
    except Exception:
        pass
    pygame.init()
    screen = pygame.display.set_mode((SCREEN_W, SCREEN_H))
    pygame.display.set_caption(TITLE)
    clock = pygame.time.Clock()
    game = Game(screen, Audio())
    frames, running, seen = 0, True, set()
    while running:
        dt = 1 / FPS if selftest else min(clock.tick(FPS) / 1000.0, 1 / 20)
        for e in pygame.event.get():
            if e.type == pygame.QUIT:
                running = False
            elif e.type == pygame.KEYDOWN and game.key(e.key) is False:
                running = False
        if selftest:
            frames += 1
            seen.add(game.state)
            if frames % 20 == 0:
                game.cat.want = random.choice(ORDER)
            if game.state == 'title':
                game.new_game()
            if frames == 4000 and game.state == 'play':
                game.maze.pellets.clear(); game.maze.nips.clear(); game.check_clear()
            if frames == 1500 and game.state == 'play':
                game.cat_on_tile(*next(iter(game.maze.nips or {(0, 0)})))
            if frames % 600 == 0:
                pygame.image.save(screen, f"shot_{frames}.png")
            if frames >= 9000:
                print("selftest OK, states:", sorted(seen), "score", game.score, "level", game.level)
                running = False
        game.update(dt)
        game.draw()
        pygame.display.flip()
    pygame.quit()


if __name__ == "__main__":
    main()
